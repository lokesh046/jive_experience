        <mxCell id="12" value="Submit the QR token. Check event assignment and ticket validity, then record entry atomically to prevent repeat use." style="html=1;whiteSpace=wrap;align=left;spacingLeft=12;spacingRight=10;fontSize=15;fillColor=#f1f5f9;strokeColor=#cbd5e1;fontColor=#172554;fontStyle=0;" vertex="1" parent="1">
