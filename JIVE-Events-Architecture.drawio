        <mxCell id="7" value="Events list / public" style="html=1;whiteSpace=wrap;align=left;spacingLeft=12;spacingRight=10;fontSize=15;fillColor=#ffffff;strokeColor=#cbd5e1;fontColor=#172554;fontStyle=0;" vertex="1" parent="1">
