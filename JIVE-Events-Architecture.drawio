  <diagram id="sign-in-endpoints" name="Sign-in endpoints">
    <mxGraphModel grid="1" page="1" pageWidth="1440" pageHeight="950">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="2" value="Sign-in endpoints" style="text;align=left;fontSize=30;fontStyle=1;fontColor=#172554;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="45" y="20" width="1350" height="50" />
        </mxCell>
        <mxCell id="3" value="Implemented · Customer site, admin dashboard and staff scanner sign-in" style="text;align=left;fontSize=15;fontColor=#155e75;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="45" y="75" width="1350" height="40" />
        </mxCell>
        <mxCell id="4" value="Product section / caller" style="html=1;whiteSpace=wrap;align=left;spacingLeft=12;spacingRight=10;fontSize=15;fillColor=#155e75;strokeColor=#cbd5e1;fontColor=#ffffff;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="45" y="130" width="215" height="44" />
        </mxCell>
        <mxCell id="5" value="Method and endpoint" style="html=1;whiteSpace=wrap;align=left;spacingLeft=12;spacingRight=10;fontSize=15;fillColor=#155e75;strokeColor=#cbd5e1;fontColor=#ffffff;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="260" y="130" width="415" height="44" />
        </mxCell>
        <mxCell id="6" value="When to call it and what it does" style="html=1;whiteSpace=wrap;align=left;spacingLeft=12;spacingRight=10;fontSize=15;fillColor=#155e75;strokeColor=#cbd5e1;fontColor=#ffffff;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="675" y="130" width="720" height="44" />
        </mxCell>
        <mxCell id="7" value="Customer sign-in / public" style="html=1;whiteSpace=wrap;align=left;spacingLeft=12;spacingRight=10;fontSize=15;fillColor=#ffffff;strokeColor=#cbd5e1;fontColor=#172554;fontStyle=0;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="45" y="174" width="215" height="70" />
        </mxCell>
        <mxCell id="8" value="GET /api/v1/auth/google/authorize" style="html=1;whiteSpace=wrap;align=left;spacingLeft=12;spacingRight=10;fontSize=15;fillColor=#ffffff;strokeColor=#cbd5e1;fontColor=#172554;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="260" y="174" width="415" height="70" />
        </mxCell>
        <mxCell id="9" value="On Continue with Google, fetch the authorization URL and state, then redirect the browser. The API generates a PKCE challenge." style="html=1;whiteSpace=wrap;align=left;spacingLeft=12;spacingRight=10;fontSize=15;fillColor=#ffffff;strokeColor=#cbd5e1;fontColor=#172554;fontStyle=0;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="675" y="174" width="720" height="70" />
        </mxCell>
        <mxCell id="10" value="Customer callback / public" style="html=1;whiteSpace=wrap;align=left;spacingLeft=12;spacingRight=10;fontSize=15;fillColor=#f1f5f9;strokeColor=#cbd5e1;fontColor=#172554;fontStyle=0;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="45" y="244" width="215" height="70" />
        </mxCell>
        <mxCell id="11" value="POST /api/v1/auth/google/callback" style="html=1;whiteSpace=wrap;align=left;spacingLeft=12;spacingRight=10;fontSize=15;fillColor=#f1f5f9;strokeColor=#cbd5e1;fontColor=#172554;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="260" y="244" width="415" height="70" />
        </mxCell>
        <mxCell id="12" value="On return from Google, the client posts code and state. The API validates the exchange, creates the customer on first sign-in and returns a token pair and user." style="html=1;whiteSpace=wrap;align=left;spacingLeft=12;spacingRight=10;fontSize=15;fillColor=#f1f5f9;strokeColor=#cbd5e1;fontColor=#172554;fontStyle=0;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="675" y="244" width="720" height="70" />
        </mxCell>
        <mxCell id="13" value="Admin or staff sign-in / public" style="html=1;whiteSpace=wrap;align=left;spacingLeft=12;spacingRight=10;fontSize=15;fillColor=#ffffff;strokeColor=#cbd5e1;fontColor=#172554;fontStyle=0;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="45" y="314" width="215" height="70" />
        </mxCell>
        <mxCell id="14" value="POST /api/v1/auth/login" style="html=1;whiteSpace=wrap;align=left;spacingLeft=12;spacingRight=10;fontSize=15;fillColor=#ffffff;strokeColor=#cbd5e1;fontColor=#172554;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="260" y="314" width="415" height="70" />
        </mxCell>
        <mxCell id="15" value="Submit email and password from the privileged login screen. Receive access and refresh tokens and the account role." style="html=1;whiteSpace=wrap;align=left;spacingLeft=12;spacingRight=10;fontSize=15;fillColor=#ffffff;strokeColor=#cbd5e1;fontColor=#172554;fontStyle=0;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="675" y="314" width="720" height="70" />
        </mxCell>
        <mxCell id="16" value="App startup / signed in" style="html=1;whiteSpace=wrap;align=left;spacingLeft=12;spacingRight=10;fontSize=15;fillColor=#f1f5f9;strokeColor=#cbd5e1;fontColor=#172554;fontStyle=0;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="45" y="384" width="215" height="70" />
        </mxCell>
        <mxCell id="17" value="GET /api/v1/auth/me" style="html=1;whiteSpace=wrap;align=left;spacingLeft=12;spacingRight=10;fontSize=15;fillColor=#f1f5f9;strokeColor=#cbd5e1;fontColor=#172554;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="260" y="384" width="415" height="70" />
        </mxCell>
        <mxCell id="18" value="Load the active identity and role to restore signed-in navigation. Send the bearer access token." style="html=1;whiteSpace=wrap;align=left;spacingLeft=12;spacingRight=10;fontSize=15;fillColor=#f1f5f9;strokeColor=#cbd5e1;fontColor=#172554;fontStyle=0;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="675" y="384" width="720" height="70" />
        </mxCell>
        <mxCell id="19" value="Google OAuth endpoints and password sign-in are rate limited. Privileged accounts are provisioned by an admin or the bootstrap CLI." style="text;html=1;whiteSpace=wrap;align=left;fontSize=14;fontColor=#155e75;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="45" y="460" width="1350" height="50" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="session-and-profile-endpoints" name="Session and profile endpoints">
    <mxGraphModel grid="1" page="1" pageWidth="1440" pageHeight="950">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="2" value="Session and profile endpoints" style="text;align=left;fontSize=30;fontStyle=1;fontColor=#172554;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="45" y="20" width="1350" height="50" />
        </mxCell>
        <mxCell id="3" value="Implemented · Shared session handling and account settings" style="text;align=left;fontSize=15;fontColor=#155e75;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="45" y="75" width="1350" height="40" />
        </mxCell>
        <mxCell id="4" value="Product section / caller" style="html=1;whiteSpace=wrap;align=left;spacingLeft=12;spacingRight=10;fontSize=15;fillColor=#155e75;strokeColor=#cbd5e1;fontColor=#ffffff;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="45" y="130" width="215" height="44" />
        </mxCell>
        <mxCell id="5" value="Method and endpoint" style="html=1;whiteSpace=wrap;align=left;spacingLeft=12;spacingRight=10;fontSize=15;fillColor=#155e75;strokeColor=#cbd5e1;fontColor=#ffffff;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="260" y="130" width="415" height="44" />
        </mxCell>
        <mxCell id="6" value="When to call it and what it does" style="html=1;whiteSpace=wrap;align=left;spacingLeft=12;spacingRight=10;fontSize=15;fillColor=#155e75;strokeColor=#cbd5e1;fontColor=#ffffff;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="675" y="130" width="720" height="44" />
        </mxCell>
        <mxCell id="7" value="Session renewal / refresh token" style="html=1;whiteSpace=wrap;align=left;spacingLeft=12;spacingRight=10;fontSize=15;fillColor=#ffffff;strokeColor=#cbd5e1;fontColor=#172554;fontStyle=0;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="45" y="174" width="215" height="70" />
        </mxCell>
        <mxCell id="8" value="POST /api/v1/auth/refresh" style="html=1;whiteSpace=wrap;align=left;spacingLeft=12;spacingRight=10;fontSize=15;fillColor=#ffffff;strokeColor=#cbd5e1;fontColor=#172554;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="260" y="174" width="415" height="70" />
        </mxCell>
        <mxCell id="9" value="When the access token expires, submit refresh_token and replace both tokens with the returned pair. Reuse of a rotated token revokes its family." style="html=1;whiteSpace=wrap;align=left;spacingLeft=12;spacingRight=10;fontSize=15;fillColor=#ffffff;strokeColor=#cbd5e1;fontColor=#172554;fontStyle=0;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="675" y="174" width="720" height="70" />
        </mxCell>
        <mxCell id="10" value="Sign out / refresh token" style="html=1;whiteSpace=wrap;align=left;spacingLeft=12;spacingRight=10;fontSize=15;fillColor=#f1f5f9;strokeColor=#cbd5e1;fontColor=#172554;fontStyle=0;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="45" y="244" width="215" height="70" />
        </mxCell>
        <mxCell id="11" value="POST /api/v1/auth/logout" style="html=1;whiteSpace=wrap;align=left;spacingLeft=12;spacingRight=10;fontSize=15;fillColor=#f1f5f9;strokeColor=#cbd5e1;fontColor=#172554;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="260" y="244" width="415" height="70" />
        </mxCell>
        <mxCell id="12" value="Submit refresh_token to revoke the current refresh token. Clear client session state. Returns 204." style="html=1;whiteSpace=wrap;align=left;spacingLeft=12;spacingRight=10;fontSize=15;fillColor=#f1f5f9;strokeColor=#cbd5e1;fontColor=#172554;fontStyle=0;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="675" y="244" width="720" height="70" />
        </mxCell>
        <mxCell id="13" value="Account security / signed in" style="html=1;whiteSpace=wrap;align=left;spacingLeft=12;spacingRight=10;fontSize=15;fillColor=#ffffff;strokeColor=#cbd5e1;fontColor=#172554;fontStyle=0;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="45" y="314" width="215" height="70" />
        </mxCell>
        <mxCell id="14" value="POST /api/v1/auth/logout-all" style="html=1;whiteSpace=wrap;align=left;spacingLeft=12;spacingRight=10;fontSize=15;fillColor=#ffffff;strokeColor=#cbd5e1;fontColor=#172554;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="260" y="314" width="415" height="70" />
        </mxCell>
        <mxCell id="15" value="Revoke all refresh tokens for the signed-in account. Returns 204." style="html=1;whiteSpace=wrap;align=left;spacingLeft=12;spacingRight=10;fontSize=15;fillColor=#ffffff;strokeColor=#cbd5e1;fontColor=#172554;fontStyle=0;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="675" y="314" width="720" height="70" />
        </mxCell>
        <mxCell id="16" value="Change password / admin or staff" style="html=1;whiteSpace=wrap;align=left;spacingLeft=12;spacingRight=10;fontSize=15;fillColor=#f1f5f9;strokeColor=#cbd5e1;fontColor=#172554;fontStyle=0;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="45" y="384" width="215" height="70" />
        </mxCell>
        <mxCell id="17" value="POST /api/v1/auth/password" style="html=1;whiteSpace=wrap;align=left;spacingLeft=12;spacingRight=10;fontSize=15;fillColor=#f1f5f9;strokeColor=#cbd5e1;fontColor=#172554;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="260" y="384" width="415" height="70" />
        </mxCell>
        <mxCell id="18" value="Submit current_password and new_password from account settings. Updates the password and revokes refresh tokens. Returns 204." style="html=1;whiteSpace=wrap;align=left;spacingLeft=12;spacingRight=10;fontSize=15;fillColor=#f1f5f9;strokeColor=#cbd5e1;fontColor=#172554;fontStyle=0;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="675" y="384" width="720" height="70" />
        </mxCell>
        <mxCell id="19" value="Profile / signed in" style="html=1;whiteSpace=wrap;align=left;spacingLeft=12;spacingRight=10;fontSize=15;fillColor=#ffffff;strokeColor=#cbd5e1;fontColor=#172554;fontStyle=0;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="45" y="454" width="215" height="70" />
        </mxCell>
        <mxCell id="20" value="GET /api/v1/users/me" style="html=1;whiteSpace=wrap;align=left;spacingLeft=12;spacingRight=10;fontSize=15;fillColor=#ffffff;strokeColor=#cbd5e1;fontColor=#172554;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="260" y="454" width="415" height="70" />
        </mxCell>
        <mxCell id="21" value="Populate the profile screen with account details and created_at." style="html=1;whiteSpace=wrap;align=left;spacingLeft=12;spacingRight=10;fontSize=15;fillColor=#ffffff;strokeColor=#cbd5e1;fontColor=#172554;fontStyle=0;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="675" y="454" width="720" height="70" />
        </mxCell>
        <mxCell id="22" value="Edit profile / signed in" style="html=1;whiteSpace=wrap;align=left;spacingLeft=12;spacingRight=10;fontSize=15;fillColor=#f1f5f9;strokeColor=#cbd5e1;fontColor=#172554;fontStyle=0;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="45" y="524" width="215" height="70" />
        </mxCell>
        <mxCell id="23" value="PATCH /api/v1/users/me" style="html=1;whiteSpace=wrap;align=left;spacingLeft=12;spacingRight=10;fontSize=15;fillColor=#f1f5f9;strokeColor=#cbd5e1;fontColor=#172554;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="260" y="524" width="415" height="70" />
        </mxCell>
        <mxCell id="24" value="Send full_name to update the display name and return the updated profile." style="html=1;whiteSpace=wrap;align=left;spacingLeft=12;spacingRight=10;fontSize=15;fillColor=#f1f5f9;strokeColor=#cbd5e1;fontColor=#172554;fontStyle=0;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="675" y="524" width="720" height="70" />
        </mxCell>
        <mxCell id="25" value="Phone entry / signed in" style="html=1;whiteSpace=wrap;align=left;spacingLeft=12;spacingRight=10;fontSize=15;fillColor=#ffffff;strokeColor=#cbd5e1;fontColor=#172554;fontStyle=0;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="45" y="594" width="215" height="70" />
        </mxCell>
        <mxCell id="26" value="PUT /api/v1/auth/phone" style="html=1;whiteSpace=wrap;align=left;spacingLeft=12;spacingRight=10;fontSize=15;fillColor=#ffffff;strokeColor=#cbd5e1;fontColor=#172554;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="260" y="594" width="415" height="70" />
        </mxCell>
        <mxCell id="27" value="Save phone_e164 and return the updated identity. Phone ownership verification remains open." style="html=1;whiteSpace=wrap;align=left;spacingLeft=12;spacingRight=10;fontSize=15;fillColor=#ffffff;strokeColor=#cbd5e1;fontColor=#172554;fontStyle=0;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="675" y="594" width="720" height="70" />
        </mxCell>
        <mxCell id="28" value="Signed-in endpoints require Authorization: Bearer &amp;lt;access_token&amp;gt;. Existing access tokens can remain valid until expiry after refresh-token revocation." style="text;html=1;whiteSpace=wrap;align=left;fontSize=14;fontColor=#155e75;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="45" y="670" width="1350" height="50" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="admin-and-system-endpoints" name="Admin and system endpoints">
    <mxGraphModel grid="1" page="1" pageWidth="1440" pageHeight="950">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="2" value="Admin and system endpoints" style="text;align=left;fontSize=30;fontStyle=1;fontColor=#172554;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="45" y="20" width="1350" height="50" />
        </mxCell>
        <mxCell id="3" value="Implemented · Account administration and infrastructure probes" style="text;align=left;fontSize=15;fontColor=#155e75;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="45" y="75" width="1350" height="40" />
        </mxCell>
        <mxCell id="4" value="Product section / caller" style="html=1;whiteSpace=wrap;align=left;spacingLeft=12;spacingRight=10;fontSize=15;fillColor=#155e75;strokeColor=#cbd5e1;fontColor=#ffffff;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="45" y="130" width="215" height="44" />
        </mxCell>
        <mxCell id="5" value="Method and endpoint" style="html=1;whiteSpace=wrap;align=left;spacingLeft=12;spacingRight=10;fontSize=15;fillColor=#155e75;strokeColor=#cbd5e1;fontColor=#ffffff;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="260" y="130" width="415" height="44" />
        </mxCell>
        <mxCell id="6" value="When to call it and what it does" style="html=1;whiteSpace=wrap;align=left;spacingLeft=12;spacingRight=10;fontSize=15;fillColor=#155e75;strokeColor=#cbd5e1;fontColor=#ffffff;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="675" y="130" width="720" height="44" />
        </mxCell>
        <mxCell id="7" value="Account directory / admin" style="html=1;whiteSpace=wrap;align=left;spacingLeft=12;spacingRight=10;fontSize=15;fillColor=#ffffff;strokeColor=#cbd5e1;fontColor=#172554;fontStyle=0;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="45" y="174" width="215" height="70" />
        </mxCell>
        <mxCell id="8" value="GET /api/v1/users" style="html=1;whiteSpace=wrap;align=left;spacingLeft=12;spacingRight=10;fontSize=15;fillColor=#ffffff;strokeColor=#cbd5e1;fontColor=#172554;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="260" y="174" width="415" height="70" />
        </mxCell>
        <mxCell id="9" value="Load paginated accounts for the admin table. Optionally filter by role and status." style="html=1;whiteSpace=wrap;align=left;spacingLeft=12;spacingRight=10;fontSize=15;fillColor=#ffffff;strokeColor=#cbd5e1;fontColor=#172554;fontStyle=0;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="675" y="174" width="720" height="70" />
        </mxCell>
        <mxCell id="10" value="Create account / admin" style="html=1;whiteSpace=wrap;align=left;spacingLeft=12;spacingRight=10;fontSize=15;fillColor=#f1f5f9;strokeColor=#cbd5e1;fontColor=#172554;fontStyle=0;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="45" y="244" width="215" height="70" />
        </mxCell>
        <mxCell id="11" value="POST /api/v1/users/staff" style="html=1;whiteSpace=wrap;align=left;spacingLeft=12;spacingRight=10;fontSize=15;fillColor=#f1f5f9;strokeColor=#cbd5e1;fontColor=#172554;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="260" y="244" width="415" height="70" />
        </mxCell>
        <mxCell id="12" value="Submit email, full_name, password and role to create an admin or event-staff account. Returns 201." style="html=1;whiteSpace=wrap;align=left;spacingLeft=12;spacingRight=10;fontSize=15;fillColor=#f1f5f9;strokeColor=#cbd5e1;fontColor=#172554;fontStyle=0;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="675" y="244" width="720" height="70" />
        </mxCell>
        <mxCell id="13" value="Account status / admin" style="html=1;whiteSpace=wrap;align=left;spacingLeft=12;spacingRight=10;fontSize=15;fillColor=#ffffff;strokeColor=#cbd5e1;fontColor=#172554;fontStyle=0;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="45" y="314" width="215" height="70" />
        </mxCell>
        <mxCell id="14" value="PATCH /api/v1/users/{user_id}/status" style="html=1;whiteSpace=wrap;align=left;spacingLeft=12;spacingRight=10;fontSize=15;fillColor=#ffffff;strokeColor=#cbd5e1;fontColor=#172554;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="260" y="314" width="415" height="70" />
        </mxCell>
        <mxCell id="15" value="Send status and optional reason to suspend, deactivate or reactivate a user. Suspension takes effect on protected requests." style="html=1;whiteSpace=wrap;align=left;spacingLeft=12;spacingRight=10;fontSize=15;fillColor=#ffffff;strokeColor=#cbd5e1;fontColor=#172554;fontStyle=0;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="675" y="314" width="720" height="70" />
        </mxCell>
        <mxCell id="16" value="Container probe / infrastructure" style="html=1;whiteSpace=wrap;align=left;spacingLeft=12;spacingRight=10;fontSize=15;fillColor=#f1f5f9;strokeColor=#cbd5e1;fontColor=#172554;fontStyle=0;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="45" y="384" width="215" height="70" />
        </mxCell>
        <mxCell id="17" value="GET /api/v1/system/health" style="html=1;whiteSpace=wrap;align=left;spacingLeft=12;spacingRight=10;fontSize=15;fillColor=#f1f5f9;strokeColor=#cbd5e1;fontColor=#172554;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="260" y="384" width="415" height="70" />
        </mxCell>
        <mxCell id="18" value="Check process liveness independently of its dependencies. Also mounted at GET /health." style="html=1;whiteSpace=wrap;align=left;spacingLeft=12;spacingRight=10;fontSize=15;fillColor=#f1f5f9;strokeColor=#cbd5e1;fontColor=#172554;fontStyle=0;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="675" y="384" width="720" height="70" />
        </mxCell>
        <mxCell id="19" value="Traffic probe / infrastructure" style="html=1;whiteSpace=wrap;align=left;spacingLeft=12;spacingRight=10;fontSize=15;fillColor=#ffffff;strokeColor=#cbd5e1;fontColor=#172554;fontStyle=0;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="45" y="454" width="215" height="70" />
        </mxCell>
        <mxCell id="20" value="GET /api/v1/system/health/ready" style="html=1;whiteSpace=wrap;align=left;spacingLeft=12;spacingRight=10;fontSize=15;fillColor=#ffffff;strokeColor=#cbd5e1;fontColor=#172554;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="260" y="454" width="415" height="70" />
        </mxCell>
        <mxCell id="21" value="Check PostgreSQL and Redis before routing traffic. Returns 503 if degraded. Also mounted at GET /health/ready." style="html=1;whiteSpace=wrap;align=left;spacingLeft=12;spacingRight=10;fontSize=15;fillColor=#ffffff;strokeColor=#cbd5e1;fontColor=#172554;fontStyle=0;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="675" y="454" width="720" height="70" />
        </mxCell>
        <mxCell id="22" value="Service metadata / diagnostics" style="html=1;whiteSpace=wrap;align=left;spacingLeft=12;spacingRight=10;fontSize=15;fillColor=#f1f5f9;strokeColor=#cbd5e1;fontColor=#172554;fontStyle=0;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="45" y="524" width="215" height="70" />
        </mxCell>
        <mxCell id="23" value="GET /api/v1/system/info" style="html=1;whiteSpace=wrap;align=left;spacingLeft=12;spacingRight=10;fontSize=15;fillColor=#f1f5f9;strokeColor=#cbd5e1;fontColor=#172554;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="260" y="524" width="415" height="70" />
        </mxCell>
        <mxCell id="24" value="Read build, environment, API version, default timezone and currency. Also mounted at GET /info." style="html=1;whiteSpace=wrap;align=left;spacingLeft=12;spacingRight=10;fontSize=15;fillColor=#f1f5f9;strokeColor=#cbd5e1;fontColor=#172554;fontStyle=0;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="675" y="524" width="720" height="70" />
        </mxCell>
        <mxCell id="25" value="The initial admin is provisioned using python -m app.cli create-admin. System endpoints are available without authentication." style="text;html=1;whiteSpace=wrap;align=left;fontSize=14;fontColor=#155e75;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="45" y="600" width="1350" height="50" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
