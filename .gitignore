# =============================================================================
# Secrets — never commit these.
# The rule is broad on purpose: it is easier to force-add one safe file than
# to rotate a leaked credential. `backend/.env` currently holds the Neon
# database password, the Google OAuth client secret and the token signing key.
# =============================================================================
.env
.env.*
!.env.example
!.env.*.example
*.pem
*.key
*.p12
*.pfx
credentials.json
service-account*.json
# The OAuth client JSON downloaded from the Google Cloud console. It contains
# the client secret verbatim; one of these was sitting in this project.
client_secret*.json
*client_secret*
secrets/
.secrets/
credential/
credentials/
cerdecital/

# Claude Code local settings may contain machine-specific paths and tokens.
.claude/settings.local.json

# =============================================================================
