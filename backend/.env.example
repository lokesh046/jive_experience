# ---------------------------------------------------------------------------
# JIVE Events API — environment template
# Copy to `.env` and fill in. NEVER commit a real .env.
# Values marked (SECRET) must come from the deployment secret store.
# ---------------------------------------------------------------------------

# --- Application -----------------------------------------------------------
APP_NAME="JIVE Events API"
ENVIRONMENT=local                  # local | test | staging | production
DEBUG=true
API_V1_PREFIX=/api/v1
DEFAULT_TIMEZONE=Asia/Kolkata      # display timezone; storage is always UTC
DEFAULT_CURRENCY=INR

# --- Security --------------------------------------------------------------
# (SECRET) Signing key for access/refresh tokens.
#   Generate with: openssl rand -hex 32
SECRET_KEY=dev-only-insecure-change-me
ACCESS_TOKEN_TTL_SECONDS=900                 # 15 minutes
REFRESH_TOKEN_TTL_SECONDS=2592000            # 30 days
CORS_ORIGINS=http://localhost:3000
TRUSTED_HOSTS=*                              # set to real hostnames in production

# --- Database --------------------------------------------------------------
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=jive
POSTGRES_PASSWORD=jive                       # (SECRET) in staging/production
POSTGRES_DB=jive_events
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=10
DB_ECHO=false

# The worker holds its own pool against the same database, sized separately so
# a busy worker cannot starve the API of connections. Behind a transaction
# pooler (Neon's -pooler endpoint) the app caps both at 5 regardless.
WORKER_DB_POOL_SIZE=5
WORKER_DB_MAX_OVERFLOW=5
# Managed provider override. Paste the console URL verbatim — a Neon,
# Supabase or RDS libpq URL is normalised for asyncpg automatically
# (scheme, sslmode, channel_binding, pooler settings). See docs/neon-setup.md.
# DATABASE_URL=postgresql://user:pass@ep-xxx-pooler.region.aws.neon.tech/neondb?sslmode=require

# --- Redis -----------------------------------------------------------------
REDIS_URL=redis://localhost:6379/0

# --- Observability ---------------------------------------------------------
LOG_LEVEL=INFO                               # DEBUG | INFO | WARNING | ERROR
LOG_JSON=false                               # true in staging/production

# --- Commerce --------------------------------------------------------------
# How long inventory is held while a customer pays. Shorter than the 10 minutes
# in the original brief: at a 2-minute sellout, seats held by people who never
# pay are the scarcest resource. See docs/capacity.md.
RESERVATION_HOLD_SECONDS=300
PAYMENT_RECONCILE_AFTER_SECONDS=600

# --- Worker ----------------------------------------------------------------
WORKER_POLL_INTERVAL_SECONDS=2.0
WORKER_BATCH_SIZE=20
WORKER_SWEEP_INTERVAL_SECONDS=15.0

# --- Rate limiting ---------------------------------------------------------
RATE_LIMIT_ENABLED=true
RATE_LIMIT_DEFAULT_TIMES=120
RATE_LIMIT_DEFAULT_SECONDS=60

# --- Google OAuth 2.0 (customer sign-in) -----------------------------------
# From Google Cloud console -> APIs & Services -> Credentials ->
#   OAuth 2.0 Client ID (type: Web application).
# The redirect URI must match one registered there EXACTLY.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=                        # (SECRET) server-side only, never in the frontend
GOOGLE_REDIRECT_URI=http://localhost:3000/auth/google/callback
OAUTH_STATE_TTL_SECONDS=600
ALLOWED_PHONE_COUNTRY_CODES=+91

# --- Auth rate limits (fail-closed) ----------------------------------------
LOGIN_RATE_LIMIT_TIMES=10
LOGIN_RATE_LIMIT_SECONDS=300
OAUTH_RATE_LIMIT_TIMES=20
OAUTH_RATE_LIMIT_SECONDS=300
MIN_PASSWORD_LENGTH=12

# ---------------------------------------------------------------------------
# NOT YET USED — added in later phases, listed here so the operator can
# prepare the accounts.
# ---------------------------------------------------------------------------
# --- Payment gateway (Razorpay) -------------------------------------------
# Leave PAYMENT_PROVIDER unset and the adapter refuses every call rather than
# pretending a payment succeeded. Set it to enable checkout and refunds.
# Setup guide: docs/razorpay-setup.md
#
# PAYMENT_PROVIDER=razorpay
# PAYMENT_KEY_ID=rzp_test_xxxxxxxxxxxxx
# PAYMENT_KEY_SECRET=                        # (SECRET) Dashboard → API Keys
# PAYMENT_WEBHOOK_SECRET=                    # (SECRET) a DIFFERENT secret, set
#                                            # when creating the webhook.
#   Leave it unset until the webhook exists — checkout and refunds work
#   without it. A placeholder is worse than nothing: every delivery then
#   fails signature verification and looks like an attack.
#
# NOTE: do not put a trailing "# comment" on a secret line. python-dotenv
# keeps it as part of the value, so the credential silently becomes wrong.
#
# Phase 6 — Transactional email (booking confirmations, tickets, refunds)
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USERNAME=
# SMTP_PASSWORD=                             # (SECRET)
# MAIL_FROM=
