{
  "cli": { "version": ">= 16.0.0", "appVersionSource": "remote" },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "ios": { "simulator": false },
      "env": { "EXPO_PUBLIC_API_URL": "http://192.168.1.5:8001", "EXPO_PUBLIC_SITE_URL": "http://192.168.1.5:3000" }
    },
    "preview": {
      "distribution": "internal",
      "env": { "EXPO_PUBLIC_API_URL": "https://api.example.com", "EXPO_PUBLIC_SITE_URL": "https://example.com" }
    },
    "production": {
      "autoIncrement": true,
      "env": { "EXPO_PUBLIC_API_URL": "https://api.example.com", "EXPO_PUBLIC_SITE_URL": "https://example.com" }
    }
  },
  "submit": { "production": {} }
}
